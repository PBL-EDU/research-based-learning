{
  "name": "@rlc/api",
  "version": "0.1.0",
  "private": true,
  "description": "Research-based Learning Community · 服务端（Fastify + Prisma + PostgreSQL）",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "issue-invite": "node scripts/issue-invite.cjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@prisma/client": "^6.19.3",
    "@rlc/contract": "workspace:*",
    "fastify": "^5.12.8",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "^6.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
