# 环境变量（复制为 .env 后修改）
# 生产环境的密码请用 openssl rand -hex 24 生成，不要用这里的示例值

# PostgreSQL 连接串
DATABASE_URL=postgresql://rlc:CHANGE_ME@127.0.0.1:5432/rlc

# 服务端口
PORT=4000

# 插件端 Bearer 令牌（至少 16 字符，建议 32）
DEVICE_TOKEN=CHANGE_ME_32_CHARS_MINIMUM________

# 作者身份（单班场景：所有发布都记在这个账号下）
AUTHOR_HANDLE=denghao
AUTHOR_NAME=邓豪

# 对外地址，用于生成卡片链接与资产 URL
PUBLIC_BASE_URL=https://dreamook.com

# 数据目录：PG 的 dump 暂存、上传的图片
DATA_DIR=/data/rlc

# 评论开关。个人备案策略：上线初期关闭，只做公开只读
COMMENTS_ENABLED=false

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info
