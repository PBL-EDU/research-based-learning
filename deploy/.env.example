# ============================================================================
# 研究性学习社区 · 环境变量
# 用法：cp .env.example .env && chmod 600 .env && 填值
#
# 规则：
#   1. 所有密码用 openssl rand -hex 24 生成（hex 不会出现 @ : / # & 这些会破坏 URL 的字符）
#   2. 含空格或特殊字符的值必须用双引号包起来（脚本会 source 这个文件）
#   3. 这个文件不进 git（.gitignore 已覆盖），也不要贴到任何聊天窗口
# ============================================================================

# ---------- 基础 ----------
TZ=Asia/Shanghai
PORTAL_DOMAIN=community.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# ---------- PostgreSQL ----------
POSTGRES_DB=rlc
POSTGRES_USER=rlc
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------- Redis ----------
# openssl rand -hex 24
REDIS_PASSWORD=

# ---------- MinIO ----------
MINIO_ROOT_USER=rlc_minio
# openssl rand -hex 24
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=rlc-assets
MINIO_REGION=cn-east-1

# ---------- 应用（apps/api） ----------
# 注意：__PG__ / __REDIS__ 由 runbook 阶段 6 的 sed 命令替换成上面的密码
# 值必须加引号，否则 URL 里的 & 会被 shell 当成后台执行
DATABASE_URL="postgresql://rlc:__PG__@postgres:5432/rlc?schema=public&connection_limit=10&pool_timeout=10"
REDIS_URL="redis://:__REDIS__@redis:6379/0"

S3_ENDPOINT=http://minio:9000
S3_BUCKET=rlc-assets
S3_REGION=cn-east-1
# 预签名 URL 必须用「浏览器能访问、且 Host 与签名时一致」的地址。
# SigV4 把 Host 算进了签名，所以不能拿内网地址签名、再用公网域名访问（会 SignatureDoesNotMatch）。
# 解法：给 MinIO 单独一个子域名，Caddy 原样反代（不剥路径），签名和访问的 Host 就一致了。
FILES_DOMAIN=files.example.com
S3_PUBLIC_ENDPOINT=https://files.example.com
# 预签名有效期（秒）。太短会让放了几小时的卡片图挂掉，见架构文档 P0 风险表
S3_PRESIGN_TTL=86400

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=

# ---------- 邮件（邮箱验证码，必填） ----------
# 阿里云邮件推送：smtpdm.aliyun.com:465（需先验证发信域名）
# 腾讯云 SES：       smtp.qcloudmail.com:465
# 绝对不要用 25 端口：腾讯云/阿里云默认封禁出站 25
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="研究性学习社区 <no-reply@example.com>"

# ---------- 微信（可选通道，实测通过才填） ----------
WECHAT_APPID=
WECHAT_SECRET=
# 本机固定公网出口 IP，填进微信后台「IP 白名单」
WECHAT_EGRESS_IP=

# ---------- 备份 ----------
# age 公钥（age1...）。私钥见下一行
AGE_PUBLIC_KEY=
# age 私钥路径：服务器上留一份供自动演练，另需一份离线副本（见 runbook 阶段 6）
AGE_KEY_FILE=/etc/rlc/age.key
# rclone 远端名，见 runbook 阶段 10
RCLONE_REMOTE=cos
BACKUP_BUCKET=rlc-backup-xxxx
BACKUP_DIR=/data/backup
# 本地保留天数 / 远端保留天数
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_REMOTE=30

# ---------- 告警 ----------
ALERT_EMAIL=you@example.com
# 可选：企业微信群机器人。留空则只写系统日志
ALERT_WEBHOOK=

# ---------- 构建（仅容器内使用，可留默认） ----------
# SRC_DIR=./src
# API_IMAGE=rlc-api:local
# PORTAL_IMAGE=rlc-portal:local
